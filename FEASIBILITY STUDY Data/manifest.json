{
  "manifest_version": 3,
  "name": "FEASIBILITY STUDY Data",
  "version": "1.6.1",
  "description": "Smart property, zoning, setbacks & capacity data extractor for Feasibility Studies.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "tabs",
    "downloads",
    "alarms"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "host_permissions": [
    "https://api.github.com/*",
    "https://propzone.gridics.com/*",
    "https://*.redfin.com/*",
    "https://*.zillow.com/*",
    "https://portal.assessor.lacounty.gov/*",
    "https://maps.assessor.lacounty.gov/*",
    "https://webapps.ocgis.com/*",
    "https://tax.ocgov.com/*",
    "https://*.rivcoacr.org/*",
    "https://ca-riverside-acr.civicplus.pro/*",
    "https://gis.countyofriverside.us/*",
    "https://*.sbcounty.gov/*",
    "https://www.arcgis.com/*",
    "http://www.ci.ontario.ca.us/*",
    "https://*.ontarioca.gov/*",
    "https://experience.arcgis.com/*",
    "https://*.google.com/*",
    "https://*.google.com.vn/*",
    "https://*.google.ca/*",
    "https://*.google.co.uk/*",
    "https://*.google.com.au/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FEASIBILITY STUDY Data Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://propzone.gridics.com/*",
        "https://portal.assessor.lacounty.gov/*",
        "https://webapps.ocgis.com/*",
        "https://experience.arcgis.com/*",
        "https://*.redfin.com/*",
        "https://*.zillow.com/*"
      ],
      "js": ["config/county-detector.js", "config/rules.js", "content/extractor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.google.com/search*",
        "https://*.google.com.vn/search*",
        "https://*.google.ca/search*",
        "https://*.google.co.uk/search*",
        "https://*.google.com.au/search*"
      ],
      "js": ["config/county-detector.js", "content/google-extractor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://webapps.ocgis.com/*"
      ],
      "js": ["content/ocgis-map-extractor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.rivcoacr.org/*",
        "https://ca-riverside-acr.civicplus.pro/*",
        "https://gis.countyofriverside.us/*"
      ],
      "js": ["content/rivco-map-extractor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.assessor.lacounty.gov/*"
      ],
      "js": ["content/la-map-extractor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.arcgis.com/apps/webappviewer/*",
        "https://*.sbcounty.gov/*",
        "http://www.ci.ontario.ca.us/*",
        "https://*.ontarioca.gov/*"
      ],
      "js": ["content/sanbernardino-map-extractor.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Mở nhanh FEASIBILITY STUDY Data Extractor"
    }
  }
}
