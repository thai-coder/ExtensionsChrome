{
  "manifest_version": 3,
  "name": "Flipbook & Document Downloader Pro",
  "version": "2.5.0",
  "description": "Tải sách Flipbook (ZIP/PDF) và In & Tải trang web thành PDF sạch sẽ (PrintFriendly) đa khổ giấy A3/A4/Letter & xoay ngang/dọc.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle_downloader": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Mở hoặc đóng bảng điều khiển tải sách & tài liệu"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/jszip.min.js",
        "lib/jspdf.min.js",
        "content/unblocker.js",
        "content/detector.js",
        "content/pdf-detector.js",
        "content/downloader.js",
        "content/pdf-engine.js",
        "content/ui.js",
        "content/content-main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/jszip.min.js", "lib/jspdf.min.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
