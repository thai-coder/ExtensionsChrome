{
  "manifest_version": 3,
  "name": "Flipbook & Book Downloader Pro",
  "version": "2.0.0",
  "description": "Tự động trích xuất và tải toàn bộ ảnh từ các trang đọc sách trực tuyến (Flipbook/PDF Viewer) thành 1 file ZIP.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/jszip.min.js",
        "content/unblocker.js",
        "content/detector.js",
        "content/downloader.js",
        "content/ui.js",
        "content/content-main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/jszip.min.js", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
